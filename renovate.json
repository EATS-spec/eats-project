{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":approveMajorUpdates",
    "group:allNonMajor"
  ],
  "timezone": "America/New_York",
  "schedule": ["before 8am on monday"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "rebaseWhen": "conflicted",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 8am on monday"]
  }
}
